# Environment Muninn reads (copy to .env, or set them in the service that runs it).
MUNINN_DATA=data                          # the data directory: config.yaml, the database, plans
MUNINN_SECRETS_DIR=data/secrets           # optional: where Muninn's own keys live (default: secrets under the data directory); `muninn init` creates them
MUNINN_PUBLIC_URL=https://<host>.<tailnet>.ts.net:8444   # the URL the app is served at (also the push subject)
